{
  "title": "FMQ-SF",
  "url": "https://www.appi.org/getattachment/4122b7fe-a9b9-44c9-9005-5e9d17fb6a28/APAP_37173_Learning-Acceptance_Goubert_CT-9_Five-Facet-Mindfulness-Questionnaire_Short-Form_FFMQ-SF.pdf",
  "instructions": "Below is a collection of statements about your everyday experience. Using the 1–5 scale below, please indicate how frequently or infrequently you have had each experience in the past month (or other agreed time period). Please answer according to what really reflects your experience rather than what you think your experience should be.",
  "lowest_value": 1,
  "statements": [
    { "code": "FMQSF1", "text": "I’m good at finding the words to describe my feelings.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF2", "text": "I can easily put my beliefs, opinions, and expectations into words.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF3", "text": "I watch my feelings without getting carried away by them.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF4", "text": "I tell myself that I shouldn’t be feeling the way I’m feeling.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF5", "text": "It’s hard for me to find the words to describe what I’m thinking.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF6", "text": "I pay attention to physical experiences, such as the wind in my hair or sun on my face.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF7", "text": "I make judgments about whether my thoughts are good or bad.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF8", "text": "I find it difficult to stay focused on what’s happening in the present moment.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF9", "text": "When I have distressing thoughts or images, I don’t let myself be carried away by them.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF10", "text": "Generally, I pay attention to sounds, such as clocks ticking, birds chirping, or cars passing.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
    { "code": "FMQSF11", "text": "When I feel something in my body, it’s hard for me to find the right words to describe it.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF12", "text": "It seems I am 'running on automatic' without much awareness of what I’m doing.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF13", "text": "When I have distressing thoughts or images, I feel calm soon after.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF14", "text": "I tell myself I shouldn’t be thinking the way I’m thinking.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF15", "text": "I notice the smells and aromas of things.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF16", "text": "Even when I’m feeling terribly upset, I can find a way to put it into words.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF17", "text": "I rush through activities without being really attentive to them.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF18", "text": "Usually, when I have distressing thoughts or images, I can just notice them without reacting.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF19", "text": "I think some of my emotions are bad or inappropriate and I shouldn’t feel them.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF20", "text": "I notice visual elements in art or nature, such as colors, shapes, textures, or patterns of light and shadow.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF21", "text": "When I have distressing thoughts or images, I just notice them and let them go.", "reversed": false, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF22", "text": "I do jobs or tasks automatically without being aware of what I’m doing.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF23", "text": "I find myself doing things without paying attention.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]},
{ "code": "FMQSF24", "text": "I disapprove of myself when I have illogical ideas.", "reversed": true, "likert_scale_points": 5, "scale_labels":[{"index":0,"label":"Never or very rarely true"},{"index":1,"label":"Not often true"},{"index":2,"label":"Sometimes true, sometimes not true"},{"index":3,"label":"Often true"},{"index":4,"label":"Very often or always true"}]}
